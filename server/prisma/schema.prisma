generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
}

model UserCart {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String
  tokens         Float           @default(0)
  password       String
  createdAt      DateTime        @default(now())
  isAdmin        Boolean         @default(false)
  productInCarts ProductInCart[]
  products       Product[]
  orders         Order[]
  coupons        Coupon[]
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  description    String?
  price          Float
  stock          Int             @default(0)
  sku            String?         @unique
  createdAt      DateTime        @default(now())
  ownerId        Int
  category       String
  owner          UserCart        @relation(fields: [ownerId], references: [id])
  productInCarts ProductInCart[]
}

model ProductInCart {
  userCart   UserCart @relation(fields: [userCartId], references: [id])
  userCartId Int
  product    Product  @relation(fields: [productId], references: [id])
  productId  Int
  quantity   Int      @default(1)
  price      Float    @default(0)
  @@id([userCartId, productId])
}

model Order {
  id             Int             @id @default(autoincrement())
  userCart       UserCart        @relation(fields: [userCartId], references: [id])
  userCartId     Int             
  receipt        String
  totalCost      Float
  status         String
}

model Coupon {
  id             Int             @id @default(autoincrement())
  userCart       UserCart        @relation(fields: [userCartId], references: [id])
  userCartId     Int
  discount       Int
  used           Boolean         @default(false)
}