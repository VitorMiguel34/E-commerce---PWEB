generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model UserCart {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  name           String
  tokens         Float           @default(0)
  password       String          @default("1234")
  createdAt      DateTime        @default(now())
  productInCarts ProductInCart[]
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String
  description    String?
  price          Float
  stock          Int             @default(0)
  sku            String?         @unique
  createdAt      DateTime        @default(now())
  productInCarts ProductInCart[]
}

model ProductInCart {
  userCart   UserCart @relation(fields: [userCartId], references: [id])
  userCartId Int
  product    Product  @relation(fields: [productId], references: [id])
  productId  Int

  @@id([userCartId, productId])
}
